{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["siteId", "name"],
  "properties": {
    "siteId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique site identifier within Xsite® MANAGE"
    },
    "name": {
      "type": "string",
      "description": "Name of the created site"
    }
  }
}
