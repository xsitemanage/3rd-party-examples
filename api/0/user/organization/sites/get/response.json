{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["siteId", "name"],
        "properties": {
          "siteId": {
            "type": "string",
            "format": "uuid",
            "description": "Unique site identifier within Xsite® MANAGE"
          },
          "name": {
            "type": "string",
            "description": "Name of the site"
          }
        }
      }
    },
    "nextToken": {
      "type": "string",
      "description": "Paging token"
    }
  }
}
