{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["body"],
  "properties": {
    "body": {
      "description": "The HTTP Request body",
      "type": "object",
      "required": ["siteId", "path"],
      "additionalProperties": false,
      "properties": {
        "siteId": {
          "description": "Site id (string, uuid)",
          "type": "string",
          "format": "uuid"
        },
        "path": {
          "description": "Path of the deleted file or empty folder (.prm and .geoid not permitted, nor .jfcl and .nfcl in the root folder)",
          "type": "string"
        }
      }
    }
  }
}
